# PostgreSQL connection string (matches docker-compose.yml service "db" when run via Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ecommerce

# Random long string used to sign our own session JWTs (not related to Google's tokens)
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Free to create. Add http://localhost:5173 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Stripe Dashboard > Developers > API keys (use TEST mode keys, both free, no card required)
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard > Developers > Webhooks (or `stripe listen --forward-to localhost:8000/api/webhooks/stripe`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Checkout currency. Most Stripe accounts: leave as usd. If your Stripe account is
# registered as an INDIVIDUAL in India, Stripe/RBI rules block it from accepting
# international payments (any foreign currency counts as "international") - set this
# to inr instead, or checkout will fail with a 502 and an account-restriction error
# in the backend logs.
STRIPE_CURRENCY=usd

# Google AI Studio (https://aistudio.google.com/apikey) - free tier Gemini API key
GOOGLE_API_KEY=your-gemini-api-key
# If this model id ever 404s, list available models in Google AI Studio and swap it in.
GEMINI_MODEL=gemini-2.5-flash

# Where the frontend runs - used for CORS and Stripe redirect URLs
FRONTEND_URL=http://localhost:5173

# Comma-separated emails that are automatically granted the admin role on first Google login
# (and retroactively on next login, if added after the account already existed)
ADMIN_EMAILS=you@example.com
